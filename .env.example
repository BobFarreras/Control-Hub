NODE_ENV=development
WEB_PORT=3001
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
# The public origin an MCP client reaches this API at, and therefore the OAuth issuer of the MCP
# authorization server. Not APP_ORIGIN (that is the web app) and not API_INTERNAL_URL (that is
# only reachable from inside the deployment). A bare origin: no path, no trailing slash.
# Required when the `mcp` flag is on; without it the MCP routes are not declared and the API says
# so at boot. It is configured rather than read from the Host header on purpose -- an audience the
# caller can choose is not an audience.
MCP_ISSUER=http://localhost:4000
LOG_LEVEL=info
DATABASE_URL=postgres://control_hub_app:local_only@127.0.0.1:5432/control_hub
MIGRATION_DATABASE_URL=postgres://control_hub_admin:local_admin_only@127.0.0.1:5432/control_hub
POSTGRES_ADMIN_PASSWORD=local_admin_only
POSTGRES_APP_PASSWORD=local_only
REDIS_URL=redis://127.0.0.1:6379
NEXT_PUBLIC_DEFAULT_LOCALE=ca
APP_ORIGIN=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=control-hub@localhost.test
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
# Comma-separated feature flags from packages/config/src/flags.ts. Empty means every flag is
# off; a name that is not declared there is ignored and reported at boot.
CONTROL_HUB_FLAGS=projects_and_time
# The connector key ring: which key seals new credentials, and every key still needed to open
# an old one. JSON, one line: {"activeKeyId":"<id>","keys":{"<id>":"<32 bytes, base64>"}}
# Generate a key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# In production it arrives as a Docker secret, never from a file in this repository. Rotation is
# adding a key and moving activeKeyId; the retired key stays until nothing is sealed under it.
# Required when the `connectors` flag is on. See docs/adr/0008-connector-credential-vault.md.
CONNECTOR_KEY_RING=
# Origins a connector may reach besides the public internet, comma separated, for services this
# installation runs itself (an n8n or a Prometheus on the same host). Scheme, host and port, no
# path: https://n8n.example.internal:5678,http://prometheus.internal:9090
# Empty means connectors reach public addresses only. No tenant can add an entry here.
CONNECTOR_INTERNAL_ALLOWLIST=
# OAuth app credentials are installation-wide secrets. Register the exact callback URLs documented
# in docs/runbooks/connect-mail.md. Client secrets belong only in the API/worker deployment secret.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=change-this-before-running
BOOTSTRAP_OWNER_NAME=Control Hub Owner
BOOTSTRAP_TENANT_NAME=Avant Business
BOOTSTRAP_TENANT_SLUG=avant-business

# Sentry error tracking. Both values come from sentry.io → Settings.
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (safe: it is not a secret).
# SENTRY_AUTH_TOKEN is used only at build time to upload source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

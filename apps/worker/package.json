    "@control-hub/database": "workspace:*",
    "@control-hub/domain": "workspace:*",
    "@control-hub/observability": "workspace:*",
    "@control-hub/persistence": "workspace:*",
    "bullmq": "^6.1.0",
    "imapflow": "1.7.1",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "postal-mime": "3.0.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",

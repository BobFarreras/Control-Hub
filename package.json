{
  "name": "control-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "node --env-file=.env node_modules/turbo/bin/turbo dev",
    "dev:api": "node --env-file=.env scripts/run-local-command.mjs api",
    "dev:all": "pnpm infra:up && pnpm db:migrate && pnpm dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose up -d --wait postgres valkey mailpit",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "db:migrate": "node --env-file=.env scripts/run-local-command.mjs migrate",
    "db:seed:dev": "node --env-file=.env scripts/run-local-command.mjs seed",
    "bootstrap:owner": "node --env-file=.env scripts/run-local-command.mjs bootstrap"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.56.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "@fastify/static": ">=10.1.1",
      "drizzle-orm": ">=0.45.2",
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0"
    }
  }
}

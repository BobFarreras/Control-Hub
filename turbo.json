{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "DATABASE_URL",
    "MIGRATION_DATABASE_URL",
    "REDIS_URL",
    "APP_ORIGIN",
    "BETTER_AUTH_SECRET",
    "API_HOST",
    "API_PORT",
    "API_INTERNAL_URL",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_FROM",
    "WEBAUTHN_RP_ID",
    "WEBAUTHN_ORIGIN",
    "NEXT_PUBLIC_DEFAULT_LOCALE",
    "CONTROL_HUB_FLAGS",
    "CONNECTOR_KEY_RING",
    "CONNECTOR_INTERNAL_ALLOWLIST",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GOOGLE_OAUTH_CLIENT_SECRET",
    "MICROSOFT_OAUTH_CLIENT_ID",
    "MICROSOFT_OAUTH_CLIENT_SECRET",
    "PLAYWRIGHT_BASE_URL",
    "NEXT_DIST_DIR",
    "CLAUDECODE",
    "TEST_DATABASE_URL",
    "TEST_DATABASE_ADMIN_URL"
  ],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "dev:verify": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "test:integration": { "cache": false }
  }
}

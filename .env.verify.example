# Entorn per verificar canvis sense tocar la sessio de ningu.
#
# `pnpm dev:verify` aixeca web i API en ports propis i contra una base de dades propia, aixi que
# es pot entrar amb un compte d'usar i llencar mentre `pnpm dev` continua servint el treball de
# debo a 3001 amb la sessio oberta.
#
# Per que no n'hi ha prou amb canviar el port: la cookie de sessio la signa BETTER_AUTH_SECRET i la
# sessio viu a una taula d'una base concreta. Servir una base o un secret diferents al port que ja
# te el navegador obert fa que l'API respongui, amb tota la rao, que aquella sessio no val, i
# l'usuari acaba al formulari d'entrada. Les tres coses han d'anar separades: port, base i secret.
#
# Copia'l a `.env.verify` i posa-hi els valors locals. `.env*` esta ignorat excepte els exemples.

NODE_ENV=development
LOG_LEVEL=warn

# Directori de sortida propi: Next es nega a un segon dev amb el mateix, encara que canvii el port.
NEXT_DIST_DIR=.next-verify

# Ports propis. El web arrenca a 3002 pel seu script `dev:verify`; l'API llegeix API_PORT.
API_HOST=127.0.0.1
API_PORT=4002
API_INTERNAL_URL=http://127.0.0.1:4002
APP_ORIGIN=http://127.0.0.1:3002
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3002
WEBAUTHN_RP_ID=127.0.0.1
WEBAUTHN_ORIGIN=http://127.0.0.1:3002

# Base de dades propia, acabada en `_e2e` perque el seed s'hi nega en qualsevol altra.
DATABASE_URL=postgres://control_hub_app:local_only@127.0.0.1:5432/control_hub_e2e
MIGRATION_DATABASE_URL=postgres://control_hub_admin:local_admin_only@127.0.0.1:5432/control_hub_e2e
REDIS_URL=redis://127.0.0.1:6379

# Secret propi: amb el mateix, una cookie d'aqui valdria a 3001 i al contrari.
BETTER_AUTH_SECRET=replace-with-a-different-32-plus-character-secret

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=control-hub@localhost.test
NEXT_PUBLIC_DEFAULT_LOCALE=ca

# Les flags que es vulguin provar.
CONTROL_HUB_FLAGS=projects_and_time

# El compte d'usar i llencar del seed.
E2E_OWNER_EMAIL=verify-owner@controlhub.test
E2E_OWNER_PASSWORD=replace-with-a-12-plus-character-password
E2E_TENANT_NAME=Control Hub Verify
E2E_TENANT_SLUG=control-hub-verify
E2E_CREDENTIALS_FILE=/ruta/absoluta/al/repositori/.e2e/verify-credentials.json
